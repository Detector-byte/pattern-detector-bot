# ============================================================
# PipSight Pro — MT5 Python Sender
# Example configuration
# Do NOT commit real secrets.
# ============================================================

# -----------------------------
# Required
# -----------------------------

MT5_SHARED_SECRET=replace-with-a-secret-at-least-32-characters

MT5_RECEIVER_URL=http://127.0.0.1:8787/v1/ingest/mt5

# -----------------------------
# Optional
# -----------------------------

MT5_BRIDGE_ID=pipsight-mt5-bridge

MT5_TERMINAL_PATH=

MT5_POLL_SECONDS=5

MT5_HTTP_TIMEOUT_SECONDS=15

MT5_MAX_RETRIES=3

MT5_RETRY_BASE_SECONDS=2

MT5_SENDER_LOG_LEVEL=INFO

# -----------------------------
# Broker symbol mapping
# Leave empty if auto-detection
# finds exactly one symbol.
# -----------------------------

MT5_SYMBOL_GBPJPY=

MT5_SYMBOL_XAUUSD=

# -----------------------------
# Sender state file
# -----------------------------

MT5_SENDER_STATE_PATH=

# -----------------------------
# Development only
# Never enable in production
# -----------------------------

MT5_ALLOW_INSECURE_REMOTE_HTTP=false
