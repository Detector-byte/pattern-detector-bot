# ==================================================
# PipSight Pro AI
# Git Ignore
# ==================================================

# Dependencies
node_modules/
.npm/

# Environment
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary Files
tmp/
temp/
*.tmp
*.temp

# Build Output
dist/
build/
coverage/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS Files
.DS_Store
Thumbs.db

# Node History
.node_repl_history

# Runtime Cache
.cache/

# Archives
*.zip
*.tar
*.gz

# Generated Reports (Uncomment if you DON'T want reports in Git)
# reports/
# dashboard/
# history/

# Local Database (if added later)
*.sqlite
*.db

# Backup Files
*.bak
*.old
